local function getAmount(raft, resource)
	local ok, result = pcall(function()
		return raft.Chest.Primary.BillboardGui.Holder[resource].Holder.Amount.Text
	end)
	if not ok or result == nil then return 0, "?" end
	local n = tonumber(result)
	if n then return n, tostring(n) end
	local digits = string.match(tostring(result), "[-%d%.]+")
	n = digits and tonumber(digits) or 0
	return n, tostring(result)
end

local function raftTotal(raft)
	local total = 0
	for _, res in ipairs(RESOURCES) do
		total += select(1, getAmount(raft, res))
	end
	return total
end

