local function waitForChar(timeout)
	timeout = timeout or 20
	local t0 = tick()
	while tick() - t0 < timeout do
		local hrp = getHRP()
		local hum = getHumanoid()
		if hrp and hum and hum.Health > 0 then
			return true
		end
		task.wait(0.2)
	end
	return getHRP() ~= nil
end

local function waitForLocalRaft(timeout)
	timeout = timeout or 25
	local t0 = tick()
	while tick() - t0 < timeout do
		if getLocalRaft() and findCaptainChair() then
			return true
		end
		task.wait(0.25)
	end
	return getLocalRaft() ~= nil
end

